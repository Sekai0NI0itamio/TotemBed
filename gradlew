##############################################################################
#
#   Gradle start up script for UN*X
#
##############################################################################

# Attempt to set APP_HOME
# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

APP_NAME="Gradle"
APP_BASE_NAME=${0##*/}

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS=""

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD="maximum"

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar


# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
fi

# Increase the maximum file descriptors if we can.
if [ "$cygwin" = "false" -a "$darwin" = "false" -a "$nonstop" = "false" ] ; then
    MAX_FD_LIMIT=$( ulimit -H -n )
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
            MAX_FD="$MAX_FD_LIMIT"
        fi
        ulimit -n $MAX_FD
        if [ $? -ne 0 ] ; then
            warn "Could not set maximum file descriptor limit: $MAX_FD"
        fi
    else
        warn "Could not query maximum file descriptor limit: $MAX_FD_LIMIT"
    fi
fi

# Collect all arguments for the java command;
#   * $DEFAULT_JVM_OPTS, $JAVA_OPTS, and $GRADLE_OPTS can contain fragments of
#     shell script including quotes and variable substitutions, so put them in
#     temporary files, so that they can be processed by sh.
#   * Put the rest of the arguments ($1, $2, ...) in a separate file, so that
#     they can also be processed by sh, one per line, while preserving quoted
#     spaces within arguments.
GRADLE_OPTS_FILE=$( mktemp ) || die "Could not create temp file for GRADLE_OPTS"
JAVA_OPTS_FILE=$( mktemp ) || die "Could not create temp file for JAVA_OPTS"
DEFAULT_JVM_OPTS_FILE=$( mktemp ) || die "Could not create temp file for DEFAULT_JVM_OPTS"
ARGS_FILE=$( mktemp ) || die "Could not create temp file for arguments"

# shellcheck disable=SC2016
# shellcheck disable=SC2006
printf '%s\n' "$GRADLE_OPTS" | sed 's/^"\(.*\)"$/\1/' > "$GRADLE_OPTS_FILE"
printf '%s\n' "$JAVA_OPTS" | sed 's/^"\(.*\)"$/\1/' > "$JAVA_OPTS_FILE"
printf '%s\n' "$DEFAULT_JVM_OPTS" | sed 's/^"\(.*\)"$/\1/' > "$DEFAULT_JVM_OPTS_FILE"
printf '%s\n' "$@" > "$ARGS_FILE"

# shellcheck disable=SC1090
# shellcheck disable=SC1091
exec "$JAVACMD" @"$DEFAULT_JVM_OPTS_FILE" @"$JAVA_OPTS_FILE" @"$GRADLE_OPTS_FILE" -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain @"$ARGS_FILE"
